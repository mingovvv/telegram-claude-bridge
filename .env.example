# keys.env 예시 — 실제 값으로 채워 /home/ubuntu/services/api-keys/keys.env 에 두고 권한 600.
# systemd EnvironmentFile 로 주입된다. (절대 커밋 금지)

# 텔레그램 봇 토큰 — @BotFather 에서 발급한 "전용 봇". 운영 알림 봇과 분리할 것.
TELEGRAM_CLAUDE_BRIDGE_BOT_TOKEN=123456:ABC-DEF...

# 허용 텔레그램 사용자 id (= 1:1 개인 DM 에서는 chat_id 와 동일). 쉼표로 다중 지정 가능.
# 이 목록에 없는 사용자는 조용히 무시된다. 비우면 기동 거부. @userinfobot 으로 본인 id 확인.
TELEGRAM_CLAUDE_BRIDGE_ALLOWED_IDS=123456789

# (선택) 모델 지정. 미설정 시 CLI 기본 모델.
# CLAUDE_BRIDGE_MODEL=claude-opus-4-8

# (선택) 작업 디렉토리. 미설정 시 /home/ubuntu.
# CLAUDE_BRIDGE_CWD=/home/ubuntu

# (선택) 시스템 프롬프트 덮어쓰기.
# CLAUDE_BRIDGE_SYSTEM_PROMPT=...
